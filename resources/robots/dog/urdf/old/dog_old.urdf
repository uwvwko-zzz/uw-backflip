<?xml version="1.0" encoding="utf-8"?>
<robot name="dog">
  <!-- ============ Materials ============ -->
  <material name="black"><color rgba="0.10196 0.10196 0.10196 1"/></material>
  <material name="silver"><color rgba="0.79216 0.81961 0.93333 1"/></material>
  <material name="gray"><color rgba="0.69804 0.69804 0.69804 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <!-- ============ Base (主基座) ============ -->
  <link name="base">
    <inertial>
      <origin xyz="0.0063754 1.9125E-17 -5.2009E-18" rpy="0 0 0"/>
      <mass value="13.555"/>
      <inertia ixx="0.051785" ixy="-6.5573E-18" ixz="-6.0673E-18" 
               iyy="0.11159" iyz="2.7689E-18" izz="0.13989"/>
