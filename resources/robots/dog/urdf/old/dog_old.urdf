      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3062 0.0935 0.104"/>
      </geometry>
    </collision>
  </link>

  <!-- ============ ODIN1 (附加设备) ============ -->
  <link name="ODIN1">
